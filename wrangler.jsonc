{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkhub",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linkhub-db",
      "database_id": "c72f1335-fc58-4a5f-be36-fd7728c1290d",
      "migrations_dir": "./migrations",
    },
  ],
}
